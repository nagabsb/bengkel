{
  "version": 2,
  "framework": null,
  "buildCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm ci && npm run build && php artisan config:cache && php artisan route:cache",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/build/(.*)", "dest": "/build/$1" },
    { "src": "^/favicon\\.ico$", "dest": "/favicon.ico" },
    { "src": "^/robots\\.txt$", "dest": "/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
